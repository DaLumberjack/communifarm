# --- Home Assistant local runtime (regenerable / sensitive) ---
# Auth tokens, user hashes, registries — never commit
devcontainer/ha_config/.storage/
devcontainer/ha_config/.cloud/
devcontainer/ha_config/.cache/
devcontainer/ha_config/.HA_VERSION
devcontainer/ha_config/.ha_run.lock
devcontainer/ha_config/home-assistant.log*
devcontainer/ha_config/home-assistant_v2.db*
devcontainer/ha_config/tts/
devcontainer/ha_config/backups/
# Bind-mount target only; source of truth is repo custom_components/communifarm/
devcontainer/ha_config/custom_components/

# Generic HA runtime patterns if paths move
**/.storage/
**/.cloud/
**/home-assistant_v2.db*
**/home-assistant.log*
config/.storage/
.ha_version

# Encrypted HA backup tarballs (restore keys are secrets; keep in OpenBao / workspace intake)
*.tar
